package StackQueueDequeueFriendly;
import java.util.Stack;
/**
 *
 * @author chamod Navinda
 */
public class StackQueueDequeueFriendly {

     Stack<Integer> s1 = new Stack<>(); // Main stack
    Stack<Integer> s2 = new Stack<>(); // Helper stack

    
    public void enqueue(int x) {

        // Move all elements from s1 to s2
        while (!s1.isEmpty()) {
            s2.push(s1.pop());
        }

        // Push new element
        s1.push(x);
        System.out.println("Enqueue : " + x);

        // Move elements back to s1
        while (!s2.isEmpty()) {
            s1.push(s2.pop());
        }
    }

    
    public int dequeue() {

        if (s1.isEmpty()) {
            System.out.println("Queue is Empty!");
            return -1;
        }

        int dequeued = s1.pop();
        System.out.println("Dequeue : " + dequeued);
        return dequeued;
    }

    // DISPLAY queue
    public void display() {
        System.out.println("Queue : " + s1);
    }

    public static void main(String[] args) {
        
        StackQueueDequeueFriendly q = new StackQueueDequeueFriendly();

        q.enqueue(3);
        q.enqueue(5);
        q.enqueue(7);
        q.display();

        q.dequeue();
        q.display();

        q.enqueue(9);
        q.display();

        q.dequeue();
        q.display();
    
    }
    
}
